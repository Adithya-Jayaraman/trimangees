#!/bin/bash
# ============================================================
# trifs — TrimangeesOS data-drive manager (runs as root via sudo)
#
# TriFS is the real filesystem of the OS. It lives on:
#   (a) a disk/partition whose label is TRIFS   (ext4), or
#   (b) a file called TriFS.img in the top folder of any other drive
#       (NTFS / exFAT / ext4) — e.g. the TRIMANGEES external drive.
#
#   trifs status            what is mounted right now          (JSON)
#   trifs scan              blank disks + drives that can host (JSON)
#   trifs mount             find a TriFS and mount it          (JSON)
#   trifs format DISK       blank disk -> new TriFS            (JSON)
#   trifs create-img PART GB   make TriFS.img on a drive       (JSON)
#   trifs unmount           flush and unmount everything       (JSON)
#
# Every command prints exactly one JSON object on stdout.
# ============================================================
export LC_ALL=C
export PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin

TRI_USER="${TRIFS_USER:-trimangees}"
MNT="${TRIFS_MNT:-/trifs}"                 # where TriFS is mounted
HOSTS="${TRIFS_HOSTS:-/mnt/host}"          # where other drives get mounted
STATE_DIR="${TRIFS_STATE:-/run/trifs}"
STATE="$STATE_DIR/state.json"
LOG="${TRIFS_LOG:-/var/log/trifs.log}"
LABEL="TRIFS"
IMG_NAME="TriFS.img"
ACCOUNTS="${TRIFS_ACCOUNTS:-Adithya Tarun Arjun}"
BIND_HOME="${TRIFS_BIND_HOME-/home}"        # /trifs/home is bind-mounted here (set empty = don't)

mkdir -p "$STATE_DIR" 2>/dev/null
log() { echo "$(date '+%F %T') $*" >> "$LOG" 2>/dev/null; }

fail() {                                   # fail "message"  -> JSON + exit 1
  log "ERROR: $*"
  jq -nc --arg e "$*" '{ok:false,error:$e}'
  exit 1
}

# ── which disk is the live medium (never touch it) ───────────
live_disk() {
  local src
  src=$(findmnt -no SOURCE /run/live/medium 2>/dev/null || findmnt -no SOURCE /lib/live/mount/medium 2>/dev/null)
  [ -n "$src" ] || return 0
  local pk
  pk=$(lsblk -no PKNAME "$src" 2>/dev/null | head -1)
  [ -n "$pk" ] && echo "/dev/$pk" || echo "$src"
}

is_mounted() { mountpoint -q "$1" 2>/dev/null; }

# ── JSON of the current mount ────────────────────────────────
status_json() {
  if is_mounted "$MNT"; then
    local total free src mode dev img
    read -r total free < <(df -B1 --output=size,avail "$MNT" | tail -1)
    src=$(findmnt -no SOURCE "$MNT")
    mode="partition"; dev="$src"; img=""
    if [ -f "$STATE" ]; then
      mode=$(jq -r '.mode // "partition"' "$STATE")
      dev=$(jq -r '.device // empty' "$STATE"); [ -n "$dev" ] || dev="$src"
      img=$(jq -r '.image // empty' "$STATE")
    fi
    jq -nc --arg mode "$mode" --arg dev "$dev" --arg img "$img" --arg root "$MNT" \
       --argjson total "${total:-0}" --argjson free "${free:-0}" \
       '{ok:true,mounted:true,mode:$mode,device:$dev,image:$img,root:$root,total:$total,free:$free,used:($total-$free)}'
  else
    jq -nc --arg root "$MNT" '{ok:true,mounted:false,mode:"none",root:$root}'
  fi
}

# ── make the folder layout and hand it to the desktop user ───
# ── keep software installed with apt after a restart ─────────
# Changes to /usr, /etc ... are written to an overlay stored on TriFS (one per
# OS build, so an older overlay never mixes with a newer system).
PERSIST_TARGETS="${TRIFS_PERSIST_TARGETS:-/usr /etc /opt /var/lib/dpkg /var/lib/apt /var/cache/apt}"
persist_on() {
  [ "${TRIFS_PERSIST:-1}" = 1 ] || return 0
  if [ "${TRIFS_PERSIST_FORCE:-0}" != 1 ] && [ ! -d /run/live/medium ] && [ ! -d /lib/live/mount/medium ]; then return 0; fi
  is_mounted "$MNT" || return 0
  local bid base t key
  bid=$(tr -dc 'A-Za-z0-9._-' < "${TRIFS_BUILDID_FILE:-/etc/trimangees-build}" 2>/dev/null | head -c 40); [ -n "$bid" ] || bid=default
  base="$MNT/system/overlay/$bid"
  for t in $PERSIST_TARGETS; do
    [ -d "$t" ] || continue
    mountpoint -q "$t" 2>/dev/null && continue
    key=$(echo "$t" | tr '/' '_')
    mkdir -p "$base/$key/upper" "$base/$key/work" 2>/dev/null || continue
    mount -t overlay overlay -o "lowerdir=$t,upperdir=$base/$key/upper,workdir=$base/$key/work" "$t" 2>>"$LOG" \
      && log "persisting $t" || log "could not persist $t"
  done
}
persist_off() {
  local t
  for t in $(echo "$PERSIST_TARGETS" | tr ' ' '\n' | tac); do
    mountpoint -q "$t" 2>/dev/null && findmnt -nro FSTYPE -M "$t" 2>/dev/null | grep -q overlay && { umount "$t" 2>/dev/null || umount -l "$t" 2>/dev/null; }
  done
}

prepare_layout() {
  local u
  mkdir -p "$MNT/home" "$MNT/Applications" "$MNT/shared" "$MNT/system"
  for u in $ACCOUNTS; do mkdir -p "$MNT/home/$u"; done
  chown "$TRI_USER:$TRI_USER" "$MNT" "$MNT/home" "$MNT/Applications" "$MNT/shared" "$MNT/system" 2>/dev/null
  for u in $ACCOUNTS; do chown "$TRI_USER:$TRI_USER" "$MNT/home/$u" 2>/dev/null; done
  if [ -n "$BIND_HOME" ] && [ -d "$BIND_HOME" ] && ! mountpoint -q "$BIND_HOME" 2>/dev/null; then
    mount --bind "$MNT/home" "$BIND_HOME" 2>>"$LOG" || log "bind mount of home failed"
  fi
  persist_on
}

write_state() {   # write_state mode device image
  jq -nc --arg m "$1" --arg d "$2" --arg i "${3:-}" '{mode:$m,device:$d,image:$i}' > "$STATE"
}

# ── mount a block device (must be ext4) at /trifs ────────────
mount_trifs_dev() {
  local dev="$1"
  mkdir -p "$MNT"
  e2fsck -p "$dev" >>"$LOG" 2>&1          # quietly repair a dirty shutdown
  mount -t ext4 -o defaults,noatime "$dev" "$MNT" 2>>"$LOG" || return 1
  write_state partition "$dev" ""
  prepare_layout
  log "mounted TriFS from $dev"
  return 0
}

# ── mount an arbitrary drive at $HOSTS/<name> ───────────────
host_mount() {   # host_mount DEV [ro|rw]  -> prints the mountpoint
  local dev="$1" mode="${2:-rw}" name mp fst
  name=$(basename "$dev")
  mp="$HOSTS/$name"
  fst=$(blkid -o value -s TYPE "$dev" 2>/dev/null)
  if is_mounted "$mp"; then
    mount -o "remount,$mode" "$mp" 2>/dev/null
    echo "$mp"; return 0
  fi
  mkdir -p "$mp"
  local uid gid; uid=$(id -u "$TRI_USER" 2>/dev/null || echo 1000); gid=$(id -g "$TRI_USER" 2>/dev/null || echo 1000)
  case "$fst" in
    ntfs)  mount -t ntfs-3g -o "$mode,noatime,uid=$uid,gid=$gid,windows_names" "$dev" "$mp" 2>>"$LOG" \
             || mount -t ntfs3 -o "$mode,noatime,uid=$uid,gid=$gid" "$dev" "$mp" 2>>"$LOG" ;;
    exfat) mount -t exfat -o "$mode,noatime,uid=$uid,gid=$gid,umask=0022" "$dev" "$mp" 2>>"$LOG" \
             || mount -t exfat-fuse -o "$mode,uid=$uid,gid=$gid" "$dev" "$mp" 2>>"$LOG" ;;
    vfat)  mount -t vfat -o "$mode,noatime,uid=$uid,gid=$gid,umask=0022" "$dev" "$mp" 2>>"$LOG" ;;
    "")    rmdir "$mp" 2>/dev/null; return 1 ;;
    *)     mount -t "$fst" -o "$mode,noatime" "$dev" "$mp" 2>>"$LOG" ;;
  esac || { rmdir "$mp" 2>/dev/null; return 1; }
  echo "$mp"
}

# ── list candidate drives ────────────────────────────────────
# lsblk gives the structure (which devices have no children); blkid -p
# probes the real filesystem type, so this works with or without udev.
probe() { blkid -p -o value -s "$2" "$1" 2>/dev/null | head -1; }     # probe DEV TYPE|LABEL

# one line per leaf device: dev|type|size|pkname|mountpoint|model|ro
leaf_devices() {
  lsblk -J -b -p -o NAME,TYPE,SIZE,PKNAME,MOUNTPOINT,MODEL,RO 2>/dev/null | jq -r '
    [ .. | objects | select(has("type")) | select((.children // []) | length == 0) ]
    | .[] | [.name, .type, (.size|tostring), (.pkname // ""), (.mountpoint // ""),
             ((.model // "disk") | gsub("[|]";" ")), ((.ro // false)|tostring)] | join("|")'
}

# Is this leaf device something we may look at?  (never the live medium or the running system)
usable_leaf() {   # usable_leaf TYPE MOUNTPOINT NAME PKNAME LIVE
  local type="$1" mp="$2" name="$3" pk="$4" live="$5"
  case "$type" in disk|part) ;; loop) [ "${TRIFS_ALLOW_LOOP:-0}" = 1 ] || return 1 ;; *) return 1 ;; esac
  [ -n "$live" ] && { [ "$name" = "$live" ] || [ "$pk" = "$live" ]; } && return 1
  case "$mp" in /|/boot|/boot/efi|/run/live/*|/lib/live/*|/usr|/var|"[SWAP]") return 1 ;; esac
  return 0
}

cmd_scan() {
  local live blank="[]" hosts="[]" found="[]"
  live=$(live_disk)
  local dev type size pk mp model ro fst lab free hasimg had hmp
  while IFS='|' read -r dev type size pk mp model ro; do
    [ -n "$dev" ] || continue
    usable_leaf "$type" "$mp" "$dev" "$pk" "$live" || continue
    fst=$(probe "$dev" TYPE)
    if [ -z "$fst" ]; then
      # no filesystem at all: a blank disk (partitions and swap are not blank)
      case "$type" in disk|loop) ;; *) continue ;; esac
      [ -z "$mp" ] && [ "$ro" != "true" ] && [ "${size:-0}" -gt 1000000000 ] || continue
      blank=$(echo "$blank" | jq -c --arg d "$dev" --argjson s "$size" --arg m "$model" '. + [{dev:$d,size:$s,model:$m}]')
      continue
    fi
    lab=$(probe "$dev" LABEL)
    if [ "$fst" = "ext4" ] && [ "$lab" = "$LABEL" ]; then
      [ -z "$mp" ] && found=$(echo "$found" | jq -c --arg d "$dev" --argjson s "$size" '. + [{dev:$d,size:$s}]')
      continue
    fi
    case "$fst" in ntfs|exfat|ext4|ext3) ;; *) continue ;; esac
    hmp="$mp"; had=1
    if [ -z "$hmp" ]; then
      hmp=$(host_mount "$dev" ro) || continue
      had=0
    fi
    free=$(df -B1 --output=avail "$hmp" 2>/dev/null | tail -1 | tr -d ' ')
    hasimg=false; [ -f "$hmp/$IMG_NAME" ] && hasimg=true
    if [ "$had" = 0 ]; then umount "$hmp" 2>/dev/null; rmdir "$hmp" 2>/dev/null; fi
    hosts=$(echo "$hosts" | jq -c --arg dev "$dev" --arg lab "$lab" --arg fst "$fst" \
        --argjson size "${size:-0}" --argjson free "${free:-0}" --argjson img "$hasimg" \
        '. + [{dev:$dev,label:$lab,fstype:$fst,size:$size,free:$free,hasImage:$img}]')
  done < <(leaf_devices)
  jq -nc --argjson b "$blank" --argjson h "$hosts" --argjson f "$found" \
     '{ok:true,blank:$b,hosts:$h,found:$f}'
}

# ── find + mount a TriFS automatically ───────────────────────
cmd_mount() {
  if is_mounted "$MNT"; then status_json; return 0; fi
  local live dev type size pk mp model ro fst lab
  live=$(live_disk)
  local plain="" imgs=""

  while IFS='|' read -r dev type size pk mp model ro; do
    [ -n "$dev" ] || continue
    usable_leaf "$type" "$mp" "$dev" "$pk" "$live" || continue
    fst=$(probe "$dev" TYPE); [ -n "$fst" ] || continue
    lab=$(probe "$dev" LABEL)
    if [ "$fst" = "ext4" ] && [ "$lab" = "$LABEL" ]; then plain="$plain $dev"; continue; fi
    case "$fst" in ntfs|exfat|ext4|ext3)
      if [ "$lab" = "TRIMANGEES" ]; then imgs="$dev $imgs"; else imgs="$imgs $dev"; fi ;;
    esac
  done < <(leaf_devices)

  # 1. a partition/disk labelled TRIFS
  for dev in $plain; do
    if mount_trifs_dev "$dev"; then status_json; return 0; fi
    log "labelled device $dev would not mount"
  done

  # 2. a TriFS.img in the top folder of another drive
  local d hm
  for d in $imgs; do
    hm=$(host_mount "$d" rw) || continue
    if [ -f "$hm/$IMG_NAME" ]; then
      e2fsck -p -f "$hm/$IMG_NAME" >>"$LOG" 2>&1
      if mount -t ext4 -o loop,defaults,noatime "$hm/$IMG_NAME" "$MNT" 2>>"$LOG"; then
        write_state image "$d" "$hm/$IMG_NAME"
        prepare_layout
        log "mounted TriFS image $hm/$IMG_NAME"
        status_json; return 0
      fi
    fi
    mountpoint -q "$hm" && umount "$hm" 2>/dev/null && rmdir "$hm" 2>/dev/null
  done
  status_json
}

# ── turn a BLANK disk into a TriFS ───────────────────────────
cmd_format() {
  local disk="$1"
  [ -b "$disk" ] || fail "$disk is not a disk"
  is_mounted "$MNT" && fail "TriFS is already mounted"
  # refuse anything that is not currently listed as blank
  if ! TRIFS_ALLOW_LOOP="${TRIFS_ALLOW_LOOP:-0}" cmd_scan | jq -e --arg d "$disk" '.blank[] | select(.dev==$d)' >/dev/null; then
    fail "$disk is not a blank disk, so I will not erase it"
  fi
  log "formatting $disk"
  wipefs -a "$disk" >>"$LOG" 2>&1
  sgdisk --zap-all "$disk" >>"$LOG" 2>&1
  sgdisk -n 1:0:0 -t 1:8300 -c 1:TRIFS "$disk" >>"$LOG" 2>&1 || fail "could not partition $disk"
  partprobe "$disk" >>"$LOG" 2>&1
  command -v udevadm >/dev/null && udevadm settle --timeout=10 >>"$LOG" 2>&1
  local part=""
  for _ in $(seq 1 40); do
    for cand in "${disk}1" "${disk}p1"; do [ -b "$cand" ] && part="$cand" && break; done
    [ -n "$part" ] && break
    partx -a "$disk" >>"$LOG" 2>&1; sleep 0.5
  done
  if [ -z "$part" ] && [ "${TRIFS_ALLOW_LOOP:-0}" = 1 ]; then
    # test rigs (loop devices) sometimes lack partition nodes: use the disk itself
    part="$disk"
  fi
  [ -n "$part" ] || fail "the new partition did not appear"
  mkfs.ext4 -F -q -L "$LABEL" -E lazy_itable_init=1,lazy_journal_init=1 "$part" >>"$LOG" 2>&1 \
    || fail "could not create the filesystem"
  mount_trifs_dev "$part" || fail "formatted, but could not mount"
  status_json
}

# ── make TriFS.img on a host drive ───────────────────────────
cmd_create_img() {
  local part="$1" gb="$2"
  [ -b "$part" ] || fail "$part is not a drive"
  case "$gb" in ''|*[!0-9]*) fail "size must be a whole number of GB";; esac
  [ "$gb" -ge 2 ] || fail "TriFS needs at least 2 GB"
  is_mounted "$MNT" && fail "TriFS is already mounted"
  local fst; fst=$(blkid -o value -s TYPE "$part" 2>/dev/null)
  [ "$fst" = "vfat" ] && fail "FAT drives cannot hold a file this big. Use NTFS or exFAT."
  local mp; mp=$(host_mount "$part" rw) || fail "could not open $part for writing"
  local img="$mp/$IMG_NAME"
  [ -e "$img" ] && fail "$IMG_NAME already exists on that drive (use Mount instead)"
  local freeb; freeb=$(df -B1 --output=avail "$mp" | tail -1 | tr -d ' ')
  local need=$(( gb * 1073741824 + 536870912 ))
  [ "${freeb:-0}" -ge "$need" ] || { umount "$mp" 2>/dev/null; fail "not enough free space for ${gb} GB on that drive"; }
  log "creating $img (${gb} GB)"
  fallocate -l "${gb}G" "$img" 2>>"$LOG" || truncate -s "${gb}G" "$img" 2>>"$LOG" || fail "could not create $IMG_NAME"
  mkfs.ext4 -F -q -L "$LABEL" -E lazy_itable_init=1,lazy_journal_init=1,nodiscard "$img" >>"$LOG" 2>&1 \
    || { rm -f "$img"; fail "could not format $IMG_NAME"; }
  mkdir -p "$MNT"
  mount -t ext4 -o loop,defaults,noatime "$img" "$MNT" 2>>"$LOG" || fail "created, but could not mount"
  write_state image "$part" "$img"
  prepare_layout
  status_json
}

cmd_unmount() {
  sync
  persist_off
  [ -n "$BIND_HOME" ] && mountpoint -q "$BIND_HOME" 2>/dev/null && { umount "$BIND_HOME" 2>/dev/null || umount -l "$BIND_HOME" 2>/dev/null; }
  if is_mounted "$MNT"; then umount "$MNT" 2>>"$LOG" || umount -l "$MNT" 2>>"$LOG"; fi
  local mp
  for mp in "$HOSTS"/*; do
    [ -d "$mp" ] && mountpoint -q "$mp" 2>/dev/null && { umount "$mp" 2>/dev/null || umount -l "$mp" 2>/dev/null; }
  done
  rm -f "$STATE"
  log "unmounted"
  status_json
}

# Boot-time version: drives (especially USB ones) can appear a few seconds late.
cmd_mount_wait() {
  local n out
  for n in 1 2 3 4 5; do
    out=$(cmd_mount)
    if echo "$out" | jq -e '.mounted == true' >/dev/null 2>&1; then echo "$out"; return 0; fi
    [ "$n" -lt 5 ] && sleep 2
  done
  echo "$out"
}

# ============================================================
# Per-account drives (TriOS MAX) — each account (Adithya/Tarun/Arjun)
# picks its OWN drive, independent of the others and independent of
# the hidden system TriFS above. Drives are real exFAT partitions
# (readable directly on Windows/Mac, no container file), tracked by
# filesystem UUID so it still works if the device path changes.
# ============================================================
USERDRIVES="${TRIFS_USERDRIVES:-/etc/trimangees/user-drives.json}"
mkdir -p "$(dirname "$USERDRIVES")" 2>/dev/null
[ -s "$USERDRIVES" ] || echo '{}' > "$USERDRIVES" 2>/dev/null

uuid_of() { blkid -o value -s UUID "$1" 2>/dev/null; }

record_user_drive() {   # record_user_drive USER UUID LABEL
  local tmp; tmp=$(mktemp)
  jq --arg u "$1" --arg id "$2" --arg lab "$3" '.[$u] = {uuid:$id, label:$lab}' "$USERDRIVES" > "$tmp" 2>/dev/null \
    && mv "$tmp" "$USERDRIVES" || rm -f "$tmp"
}
drive_for_user() { jq -r --arg u "$1" '.[$u].uuid // empty' "$USERDRIVES" 2>/dev/null; }

# Drives a user could pick: blank disks, or any already-formatted
# partition not already claimed by someone else and not the hidden
# system TriFS itself.
cmd_user_scan() {
  local live assigned out="[]"
  live=$(live_disk)
  assigned=$(jq -c '[.[].uuid]' "$USERDRIVES" 2>/dev/null || echo '[]')
  local dev type size pk mp model ro fst lab uid
  while IFS='|' read -r dev type size pk mp model ro; do
    [ -n "$dev" ] || continue
    usable_leaf "$type" "$mp" "$dev" "$pk" "$live" || continue
    fst=$(probe "$dev" TYPE)
    if [ -z "$fst" ]; then
      case "$type" in disk|loop) ;; *) continue ;; esac
      [ -z "$mp" ] && [ "$ro" != "true" ] && [ "${size:-0}" -gt 200000000 ] || continue
      out=$(echo "$out" | jq -c --arg d "$dev" --argjson s "$size" --arg m "$model" '. + [{dev:$d,size:$s,model:$m,blank:true}]')
      continue
    fi
    lab=$(probe "$dev" LABEL); uid=$(uuid_of "$dev")
    [ "$lab" = "$LABEL" ] && continue    # the hidden system TriFS — never offer it to a user
    echo "$assigned" | jq -e --arg id "$uid" 'index($id)' >/dev/null 2>&1 && continue   # already someone's
    case "$fst" in ntfs|exfat|vfat|ext4|ext3) ;; *) continue ;; esac
    out=$(echo "$out" | jq -c --arg d "$dev" --arg lab "$lab" --arg fst "$fst" --argjson size "${size:-0}" \
          '. + [{dev:$d,label:$lab,fstype:$fst,size:$size,blank:false}]')
  done < <(leaf_devices)
  jq -nc --argjson d "$out" '{ok:true,drives:$d}'
}

# One blank disk -> everything: a small hidden ext4 partition for the
# system (installed packages, settings — the usual TriFS job) plus the rest
# of the disk as one shared exFAT partition. Mounts the system partition
# right away; the exFAT one shows up afterwards in user-scan as a normal
# already-formatted choice (labelled TRIFS-SHARED) that any account —
# or several accounts at once — can pick, each getting its own folder on it.
cmd_combo_format() {
  local disk="$1" sysgb="${2:-4}" part1 part2
  [ -b "$disk" ] || fail "$disk is not a disk"
  is_mounted "$MNT" && fail "the system TriFS is already mounted"
  case "$sysgb" in ''|*[!0-9]*) fail "the system part's size must be a whole number of GB";; esac
  if ! cmd_scan | jq -e --arg d "$disk" '.blank[] | select(.dev==$d)' >/dev/null; then
    fail "$disk is not a blank disk, so I will not erase it"
  fi
  log "combo-formatting $disk: ${sysgb}GB system + the rest shared exFAT"
  wipefs -a "$disk" >>"$LOG" 2>&1
  sgdisk --zap-all "$disk" >>"$LOG" 2>&1
  sgdisk -n 1:0:+"${sysgb}"G -t 1:8300 -c 1:"$LABEL" \
         -n 2:0:0           -t 2:0700  -c 2:TRIFS-SHARED "$disk" >>"$LOG" 2>&1 || fail "could not partition $disk"
  partprobe "$disk" >>"$LOG" 2>&1
  command -v udevadm >/dev/null && udevadm settle --timeout=10 >>"$LOG" 2>&1
  part1=""; part2=""
  for _ in $(seq 1 40); do
    for cand in "${disk}1" "${disk}p1"; do [ -b "$cand" ] && part1="$cand" && break; done
    for cand in "${disk}2" "${disk}p2"; do [ -b "$cand" ] && part2="$cand" && break; done
    [ -n "$part1" ] && [ -n "$part2" ] && break
    partx -a "$disk" >>"$LOG" 2>&1; sleep 0.5
  done
  [ -n "$part1" ] && [ -n "$part2" ] || fail "the new partitions did not appear"
  mkfs.ext4 -F -q -L "$LABEL" -E lazy_itable_init=1,lazy_journal_init=1 "$part1" >>"$LOG" 2>&1 \
    || fail "could not create the system filesystem"
  mkfs.exfat -n TRIFS-SHARED "$part2" >>"$LOG" 2>&1 \
    || fail "could not create the shared filesystem"
  mount_trifs_dev "$part1" || fail "system partition formatted, but could not mount"
  jq -nc --arg s "$part1" --arg sh "$part2" '{ok:true,mounted:true,system:$s,shared:$sh}'
}

# Give a drive to a user: blank disk -> new exFAT partition labelled
# TRIFS-<USER>; an already-formatted drive -> used as-is, whatever is
# on it already.
cmd_user_assign() {
  local user="$1" dev="$2" lab part fst id
  [ -n "$user" ] && [ -n "$dev" ] || fail "usage: trifs user-assign USER DEVICE"
  [ -b "$dev" ] || fail "$dev is not a drive"
  lab="TRIFS-$(echo "$user" | tr '[:lower:]' '[:upper:]' | tr -dc 'A-Z0-9' | cut -c1-15)"
  fst=$(probe "$dev" TYPE)
  if [ -z "$fst" ]; then
    log "formatting $dev as exFAT for $user"
    wipefs -a "$dev" >>"$LOG" 2>&1
    sgdisk --zap-all "$dev" >>"$LOG" 2>&1
    sgdisk -n 1:0:0 -t 1:0700 -c 1:"$lab" "$dev" >>"$LOG" 2>&1 || fail "could not partition $dev"
    partprobe "$dev" >>"$LOG" 2>&1
    command -v udevadm >/dev/null && udevadm settle --timeout=10 >>"$LOG" 2>&1
    part=""
    for _ in $(seq 1 40); do
      for cand in "${dev}1" "${dev}p1"; do [ -b "$cand" ] && part="$cand" && break; done
      [ -n "$part" ] && break
      partx -a "$dev" >>"$LOG" 2>&1; sleep 0.5
    done
    [ -n "$part" ] || fail "the new partition did not appear"
    mkfs.exfat -n "$lab" "$part" >>"$LOG" 2>&1 || fail "could not format $part as exFAT"
  else
    part="$dev"
    lab=$(probe "$part" LABEL); [ -n "$lab" ] || lab="(unlabeled)"
  fi
  id=$(uuid_of "$part")
  [ -n "$id" ] || fail "could not read the new partition's id"
  record_user_drive "$user" "$id" "$lab"
  cmd_user_mount "$user" >/dev/null
  jq -nc --arg u "$user" --arg d "$part" --arg lab "$lab" '{ok:true,user:$u,device:$d,label:$lab}'
}

# Mount USER's drive and bind their own folder on it onto /home/<user>.
# The drive is mounted once into a shared "pool" keyed by its UUID, and each
# account gets an isolated subfolder inside that pool — so two accounts CAN
# safely share the same physical drive (the "one drive for everything" case)
# without seeing each other's files, and nothing changes for an account with
# a drive all to themselves.
cmd_user_mount() {
  local user="$1" id dev mp fst uid gid shortid poolmp userdir
  [ -n "$user" ] || fail "usage: trifs user-mount USER"
  id=$(drive_for_user "$user")
  if [ -z "$id" ]; then jq -nc --arg u "$user" '{ok:true,user:$u,mounted:false,reason:"no drive chosen yet"}'; return 0; fi
  dev=$(blkid -U "$id" 2>/dev/null)
  if [ -z "$dev" ]; then jq -nc --arg u "$user" '{ok:true,user:$u,mounted:false,reason:"drive not plugged in"}'; return 0; fi
  mp="/trifs/home/$user"
  if is_mounted "$mp"; then jq -nc --arg u "$user" --arg d "$dev" '{ok:true,user:$u,mounted:true,device:$d}'; return 0; fi

  uid=$(id -u "$TRI_USER" 2>/dev/null || echo 1000); gid=$(id -g "$TRI_USER" 2>/dev/null || echo 1000)
  shortid=$(echo "$id" | tr -dc 'A-Za-z0-9' | cut -c1-12)
  poolmp="/mnt/trifs-pool/$shortid"
  if ! is_mounted "$poolmp"; then
    mkdir -p "$poolmp"
    fst=$(probe "$dev" TYPE)
    case "$fst" in
      exfat) mount -t exfat -o rw,noatime,uid=$uid,gid=$gid,umask=0022 "$dev" "$poolmp" 2>>"$LOG" \
               || mount -t exfat-fuse -o rw,uid=$uid,gid=$gid "$dev" "$poolmp" 2>>"$LOG" ;;
      vfat)  mount -t vfat -o rw,noatime,uid=$uid,gid=$gid,umask=0022 "$dev" "$poolmp" 2>>"$LOG" ;;
      ntfs)  mount -t ntfs-3g -o rw,noatime,uid=$uid,gid=$gid,windows_names "$dev" "$poolmp" 2>>"$LOG" \
               || mount -t ntfs3 -o rw,noatime,uid=$uid,gid=$gid "$dev" "$poolmp" 2>>"$LOG" ;;
      ext4|ext3) mount -o defaults,noatime "$dev" "$poolmp" 2>>"$LOG" ;;
      *)     mount "$dev" "$poolmp" 2>>"$LOG" ;;
    esac || { rmdir "$poolmp" 2>/dev/null; fail "could not mount $dev for $user"; }
  fi
  userdir="$poolmp/$user"
  mkdir -p "$userdir/Desktop" "$userdir/Documents" "$userdir/Downloads" "$userdir/Pictures" 2>/dev/null
  chown -R "$uid:$gid" "$userdir" 2>/dev/null
  mkdir -p "$mp"
  mount --bind "$userdir" "$mp" 2>>"$LOG" || fail "could not use $user's folder on $dev"
  if [ -d "/home/$user" ] && ! mountpoint -q "/home/$user" 2>/dev/null; then
    mount --bind "$mp" "/home/$user" 2>>"$LOG" || log "bind of /home/$user onto their own drive failed"
  fi
  log "mounted $user's folder on $dev at $mp"
  jq -nc --arg u "$user" --arg d "$dev" '{ok:true,user:$u,mounted:true,device:$d}'
}

cmd_user_mount_all() {
  local u out="[]" r
  for u in $(jq -r 'keys[]' "$USERDRIVES" 2>/dev/null); do
    r=$(cmd_user_mount "$u")
    out=$(echo "$out" | jq -c --argjson r "$r" '. + [$r]')
  done
  jq -nc --argjson r "$out" '{ok:true,results:$r}'
}

cmd_user_status() {
  jq -nc --slurpfile m <(cat "$USERDRIVES" 2>/dev/null || echo '{}') '{ok:true,drives:$m[0]}'
}

cmd_user_unassign() {
  local user="$1" tmp id stillused shortid poolmp
  [ -n "$user" ] || fail "usage: trifs user-unassign USER"
  mountpoint -q "/home/$user" 2>/dev/null && { umount "/home/$user" 2>/dev/null || umount -l "/home/$user" 2>/dev/null; }
  mountpoint -q "/trifs/home/$user" 2>/dev/null && { umount "/trifs/home/$user" 2>/dev/null || umount -l "/trifs/home/$user" 2>/dev/null; }
  id=$(drive_for_user "$user")
  tmp=$(mktemp)
  jq --arg u "$user" 'del(.[$u])' "$USERDRIVES" > "$tmp" 2>/dev/null && mv "$tmp" "$USERDRIVES" || rm -f "$tmp"
  if [ -n "$id" ]; then
    stillused=$(jq -r --arg id "$id" '[.[] | select(.uuid==$id)] | length' "$USERDRIVES" 2>/dev/null || echo 0)
    if [ "${stillused:-0}" = 0 ]; then
      shortid=$(echo "$id" | tr -dc 'A-Za-z0-9' | cut -c1-12); poolmp="/mnt/trifs-pool/$shortid"
      mountpoint -q "$poolmp" 2>/dev/null && { umount "$poolmp" 2>/dev/null || umount -l "$poolmp" 2>/dev/null; }
    fi
  fi
  jq -nc --arg u "$user" '{ok:true,user:$u,unassigned:true}'
}

case "${1:-}" in
  status)      status_json ;;
  mount-wait)  cmd_mount_wait ;;
  scan)        cmd_scan ;;
  mount)       cmd_mount ;;
  format)      [ -n "${2:-}" ] || fail "which disk?"; cmd_format "$2" ;;
  create-img)  [ -n "${2:-}" ] && [ -n "${3:-}" ] || fail "usage: trifs create-img PARTITION GB"; cmd_create_img "$2" "$3" ;;
  persist)     persist_on; status_json ;;
  unmount|umount) cmd_unmount ;;
  combo-format)    [ -n "${2:-}" ] || fail "usage: trifs combo-format DISK [SYSGB]"; cmd_combo_format "$2" "${3:-4}" ;;
  user-scan)       cmd_user_scan ;;
  user-assign)     [ -n "${2:-}" ] && [ -n "${3:-}" ] || fail "usage: trifs user-assign USER DEVICE"; cmd_user_assign "$2" "$3" ;;
  user-mount)      [ -n "${2:-}" ] || fail "usage: trifs user-mount USER"; cmd_user_mount "$2" ;;
  user-mount-all)  cmd_user_mount_all ;;
  user-status)     cmd_user_status ;;
  user-unassign)   [ -n "${2:-}" ] || fail "usage: trifs user-unassign USER"; cmd_user_unassign "$2" ;;
  *) echo '{"ok":false,"error":"usage: trifs status|scan|mount|format DISK|create-img PART GB|unmount|combo-format DISK [SYSGB]|user-scan|user-assign USER DEV|user-mount USER|user-mount-all|user-status|user-unassign USER"}'; exit 2 ;;
esac
